# ─── Telegram API ────────────────────────────────────────────────────────────
# https://my.telegram.org/apps dan oling
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+998XXXXXXXXX

# ─── Anthropic API ───────────────────────────────────────────────────────────
# https://console.anthropic.com dan oling
ANTHROPIC_API_KEY=sk-ant-...

# Claude modeli
# claude-sonnet-4-20250514 — foydalanuvchi tanlagan model (2026-06-15 da eskiradi)
# claude-sonnet-4-6        — tavsiya etilgan zamonaviy model
CLAUDE_MODEL=claude-sonnet-4-20250514

# ─── Whisper (ovoz → matn) ───────────────────────────────────────────────────
# Model o'lchami: tiny | base | small | medium | large
# base — tezlik va aniqlik o'rtasida muvozanat (tavsiya)
# small — aniqroq, lekin sekinroq
WHISPER_MODEL=base

# Whisper tili (bo'sh = avtomatik aniqlash)
# uz = O'zbek, ru = Rus, en = Ingliz
WHISPER_LANGUAGE=

# ─── Boshqalar ───────────────────────────────────────────────────────────────
SESSION_NAME=userbot_session
MAX_HISTORY=20
